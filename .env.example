# ==========================================
# Frontend Configuration (Firebase Auth)
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ==========================================
# Frontend API endpoint + local preview
# ==========================================
# Leave EMPTY for local development: the app then calls same-origin "/api/v1",
# which the Vite dev server forwards to VITE_API_PROXY_TARGET below (works on
# localhost, 127.0.0.1, a LAN IP — no hard-coded localhost inside the app).
# Set it only when the API lives somewhere else (deployed/staging backend).
VITE_API_BASE_URL=

# Where the Vite dev server forwards "/api/*" (your own FastAPI backend).
# Change it when the backend runs on another host/port.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Local UI preview without Firebase login — honoured by the Vite dev server only
# (never by `npm run build`):
#   true  = always preview (no login required)
#   false = always use the real Firebase login
#   unset = preview automatically while no real VITE_FIREBASE_API_KEY is set
# VITE_DEV_PREVIEW=true

# ==========================================
# Backend Configuration (FastAPI & AI)
# ==========================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq Cloud API (Two-Way Conversational AI Coach)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper Configuration (Local CPU INT8 for 4 GB RAM PC)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Firebase Backend Verification
FIREBASE_PROJECT_ID=your_project_id_here

# Field-Level Encryption
ENCRYPTION_KEY=your_aes_256_gcm_or_fernet_encryption_key_here
JOURNAL_ENCRYPTION_KEY=your_generated_32_byte_base64_encryption_key_here

# PostgreSQL Database Configuration (Docker Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_goal_journal
